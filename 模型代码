# ==========================================================
# 7. 检测结果合成最终视频
# ==========================================================
import cv2

input_video = r"video_yolo_project/runs/detect/predict/test_video.mp4"

cap = cv2.VideoCapture(input_video)
fps = cap.get(cv2.CAP_PROP_FPS)
w = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
h = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))

fourcc = cv2.VideoWriter_fourcc(*"XVID")
out = cv2.VideoWriter(
    r"video_yolo_project/final_output.avi",
    fourcc,
    fps,
    (w, h)
)

while True:
    ret, frame = cap.read()
    if not ret:
        break
    out.write(frame)

cap.release()
out.release()
print("✅ 最终视频合成完成：final_output.avi")
