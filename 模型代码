import cv2
import glob
import os

test_dir = r"video_yolo_project/test_images"
output_video = r"video_yolo_project/test_video.mp4"

img_files = sorted(glob.glob(os.path.join(test_dir, "*.jpg")))
first = cv2.imread(img_files[0])
h, w, _ = first.shape

fourcc = cv2.VideoWriter_fourcc(*"mp4v")
out = cv2.VideoWriter(output_video, fourcc, 25, (w, h))

for img_path in img_files:
    out.write(cv2.imread(img_path))

out.release()
print("✅ 测试视频已生成")

